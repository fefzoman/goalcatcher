# Terraform working data and state
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
.terraform.lock.hcl

# Local configuration can contain project- or operator-specific data
*.tfvars
*.tfvars.json
!*.tfvars.example

# Terraform CLI configuration and provider overrides
.terraformrc
terraform.rc
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Lock files are intentionally committed for reproducible provider selection.

# Python caches and local secrets
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.env
.env.*
!.env.example
