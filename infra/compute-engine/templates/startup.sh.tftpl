#!/usr/bin/env bash
set -euo pipefail

readonly APP_USER="football-alert"
readonly APP_GROUP="football-alert"
readonly APP_DIRECTORY="${app_directory}"

if ! getent group "$APP_GROUP" >/dev/null; then
  groupadd --system "$APP_GROUP"
fi

if ! id "$APP_USER" >/dev/null 2>&1; then
  useradd \
    --system \
    --gid "$APP_GROUP" \
    --home-dir "$APP_DIRECTORY" \
    --create-home \
    --shell /usr/sbin/nologin \
    "$APP_USER"
fi

install -d -o "$APP_USER" -g "$APP_GROUP" -m 0750 \
  "$APP_DIRECTORY/src" \
  "$APP_DIRECTORY/config"

missing_packages=()
for package in python3 python3-venv python3-pip; do
  dpkg-query -W -f='$${Status}' "$package" 2>/dev/null | grep -q "ok installed" || missing_packages+=("$package")
done

if (( $${#missing_packages[@]} > 0 )); then
  apt-get update
  DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "$${missing_packages[@]}"
fi

# uv manages the application virtualenv from pyproject.toml and uv.lock. It is
# installed into its own venv so the system Python stays externally managed.
if [[ ! -x /usr/local/bin/uv ]]; then
  python3 -m venv /opt/uv
  /opt/uv/bin/pip install --upgrade pip uv
  ln -sf /opt/uv/bin/uv /usr/local/bin/uv
fi

if [[ ! -x "$APP_DIRECTORY/.venv/bin/python" ]]; then
  runuser -u "$APP_USER" -- python3 -m venv "$APP_DIRECTORY/.venv"
fi

printf '%s' '${application_environment_base64}' | base64 --decode >/etc/football-goal-alert.env
chmod 0644 /etc/football-goal-alert.env

printf '%s' '${service_unit_base64}' | base64 --decode >/etc/systemd/system/football-goal-alert.service
chmod 0644 /etc/systemd/system/football-goal-alert.service
chown -R "$APP_USER:$APP_GROUP" "$APP_DIRECTORY"

systemctl daemon-reload

echo "Football goal alert host initialization completed"
