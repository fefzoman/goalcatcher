[Unit]
Description=Football first-goal monitoring service
Wants=network-online.target
After=network-online.target
ConditionPathExists=/opt/football-goal-alert/src/monitor.py
ConditionPathExists=/opt/football-goal-alert/.env

[Service]
Type=simple
User=football-alert
Group=football-alert
WorkingDirectory=/opt/football-goal-alert
EnvironmentFile=/etc/football-goal-alert.env
EnvironmentFile=/opt/football-goal-alert/.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/football-goal-alert/.venv/bin/python -m src.monitor
Restart=always
RestartSec=15
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/opt/football-goal-alert
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
